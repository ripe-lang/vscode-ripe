{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Ripe",
	"scopeName": "source.ripe",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#chars" },
		{ "include": "#numbers" },
		{ "include": "#function-definition-name" },
		{ "include": "#type-definition-name" },
		{ "include": "#labels" },
		{ "include": "#declaration-keywords" },
		{ "include": "#control-keywords" },
		{ "include": "#modifier-keywords" },
		{ "include": "#operator-keywords" },
		{ "include": "#builtin-types" },
		{ "include": "#constants" },
		{ "include": "#binding-operators" },
		{ "include": "#type-annotation" },
		{ "include": "#operators" },
		{ "include": "#terminator" }
	],
	"repository": {

		"comments": {
			"patterns": [
				{
					"name": "comment.line.documentation.ripe",
					"begin": "///",
					"end": "$",
					"beginCaptures": { "0": { "name": "punctuation.definition.comment.ripe" } }
				},
				{
					"name": "comment.line.double-slash.ripe",
					"begin": "//",
					"end": "$",
					"beginCaptures": { "0": { "name": "punctuation.definition.comment.ripe" } }
				},
				{ "include": "#block-comment" }
			]
		},

		"block-comment": {
			"name": "comment.block.ripe",
			"begin": "/\\*",
			"end": "\\*/",
			"captures": { "0": { "name": "punctuation.definition.comment.ripe" } },
			"patterns": [{ "include": "#block-comment" }]
		},

		"strings": {
			"name": "string.quoted.double.ripe",
			"begin": "\"",
			"end": "\"",
			"beginCaptures": { "0": { "name": "punctuation.definition.string.begin.ripe" } },
			"endCaptures":   { "0": { "name": "punctuation.definition.string.end.ripe" } },
			"patterns": [
				{
					"name": "constant.character.escape.ripe",
					"match": "\\\\[nrt0\\\\\"]"
				}
			]
		},

		"chars": {
			"name": "string.quoted.single.ripe",
			"match": "'(?:[^'\\\\]|\\\\[nrt0\\\\'])'"
		},

		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.hex.ripe",
					"match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*(i8|i16|i32|i64|isize|u8|u16|u32|u64|usize)?\\b"
				},
				{
					"name": "constant.numeric.binary.ripe",
					"match": "\\b0[bB][01][01_]*(i8|i16|i32|i64|isize|u8|u16|u32|u64|usize)?\\b"
				},
				{
					"name": "constant.numeric.octal.ripe",
					"match": "\\b0[oO][0-7][0-7_]*(i8|i16|i32|i64|isize|u8|u16|u32|u64|usize)?\\b"
				},
				{
					"name": "constant.numeric.float.ripe",
					"match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?(f32|f64)?\\b"
				},
				{
					"name": "constant.numeric.float.ripe",
					"match": "\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*(f32|f64)?\\b"
				},
				{
					"name": "constant.numeric.float.ripe",
					"match": "\\b[0-9][0-9_]*(f32|f64)\\b"
				},
				{
					"name": "constant.numeric.integer.ripe",
					"match": "\\b[0-9][0-9_]*(i8|i16|i32|i64|isize|u8|u16|u32|u64|usize)?\\b"
				}
			]
		},

		"function-definition-name": {
			"comment": "name :: fn(...), name := fn(...), name :: extern \"C\" fn(...), name : (i32) -> i32 : fn match { }, name : (i32) -> i32 = fn(x) => x, name : (cstr) -> i32 : extern \"C\", the name only counts at the start of a line or after ; or { so a type like i32 in the middle never does",
			"patterns": [
				{
					"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*(fn)\\b",
					"captures": {
						"1": { "name": "entity.name.function.ripe" },
						"2": { "name": "keyword.operator.declaration.ripe" },
						"3": { "name": "storage.type.function.ripe" }
					}
				},
				{
					"match": "(?:^|(?<=[;{]))\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?::=|::)\\s*(?:extern\\s*\"[^\"]*\"\\s*)?fn\\b)",
					"captures": { "1": { "name": "entity.name.function.ripe" } }
				},
				{
					"match": "(?:^|(?<=[;{]))\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:(?![:=])[^:=;]*(?::|=)\\s*(?:fn|extern)\\b)",
					"captures": { "1": { "name": "entity.name.function.ripe" } }
				}
			]
		},

		"type-definition-name": {
			"comment": "Point :: struct { }, Color :: enum { }, Point : type : struct { }, Code : type : i32, Point : _ : struct { }",
			"patterns": [
				{
					"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*(struct|enum)\\b",
					"captures": {
						"1": { "name": "entity.name.type.ripe" },
						"2": { "name": "keyword.operator.declaration.ripe" },
						"3": { "name": "storage.type.ripe" }
					}
				},
				{
					"match": "(?:^|(?<=[;{]))\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:\\s*(?:type\\s*:(?![:=])|_\\s*:\\s*(?:struct|enum)\\b))",
					"captures": { "1": { "name": "entity.name.type.ripe" } }
				}
			]
		},

		"labels": {
			"comment": "loop @outer { }, break @outer",
			"name": "entity.name.label.ripe",
			"match": "@[A-Za-z_][A-Za-z0-9_]*"
		},

		"binding-operators": {
			"comment": "must precede type-annotation so :: and := stay whole",
			"name": "keyword.operator.declaration.ripe",
			"match": "::|:="
		},

		"declaration-keywords": {
			"name": "storage.type.ripe",
			"match": "\\b(fn|struct|enum)\\b"
		},

		"control-keywords": {
			"name": "keyword.control.ripe",
			"match": "\\b(if|else|while|for|break|continue|return|loop|match)\\b"
		},

		"modifier-keywords": {
			"name": "storage.modifier.ripe",
			"match": "\\b(extern)\\b"
		},

		"operator-keywords": {
			"name": "keyword.operator.word.ripe",
			"match": "\\b(sizeof|cast)\\b"
		},

		"builtin-types": {
			"name": "support.type.ripe",
			"match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|isize|usize|f32|f64|bool|char|cstr|str|never|ptr|type)\\b"
		},

		"constants": {
			"name": "constant.language.ripe",
			"match": "\\b(true|false|null)\\b"
		},

		"type-annotation": {
			"comment": ": after a parameter or binding name",
			"match": "(?<=[A-Za-z0-9_])\\s*(:)(?![:=])",
			"captures": {
				"1": { "name": "punctuation.separator.type-annotation.ripe" }
			}
		},

		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.arrow.ripe",
					"match": "->|=>"
				},
				{
					"name": "keyword.operator.assignment.compound.ripe",
					"match": "&&=|\\|\\|=|<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
				},
				{
					"name": "keyword.operator.comparison.ripe",
					"match": "==|!=|<=|>=|<(?!<)|(?<!>)>(?!>)"
				},
				{
					"name": "keyword.operator.range.ripe",
					"match": "\\.\\.=|\\.\\."
				},
				{
					"name": "keyword.operator.logical.ripe",
					"match": "&&|\\|\\|"
				},
				{
					"name": "keyword.operator.assignment.ripe",
					"match": "(?<![=!<>])=(?![=])"
				},
				{
					"name": "keyword.operator.arithmetic.ripe",
					"match": "[+\\-*/%]"
				},
				{
					"name": "keyword.operator.bitwise.ripe",
					"match": "<<|>>|[&|~^]"
				},
				{
					"name": "keyword.operator.logical.ripe",
					"match": "!"
				}
			]
		},

		"terminator": {
			"name": "punctuation.terminator.statement.ripe",
			"match": ";"
		}
	}
}
