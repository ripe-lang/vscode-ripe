// Highlighting
import math.vector

struct point { x: i32, y: i32 }

struct rect { origin: point, w: i32, h: i32 }

comptime PI: f32 = 3.14159
let ORIGIN: point = point { x: 0, y: 0 }

extern func printf(fmt: cstr, ...) i32
extern func malloc(size: usize) *opaque

func width(s: str) usize {
  return s.len
}

func area(r: rect) i64 {
  return r.w as i64 * r.h as i64
}

func classify(n: i32) i32 {
  if n < 0 {
    return -1
  } else if n > 0 {
    return 1
  } else {
    return 0
  }
}

func bits(flags: u8, mask: u8) u8 {
  return flags & mask | ~mask ^ flags << 1 >> 2
}

pub func main() i32 {
  var total: i64 = 0
  var buf: [4]i32 = undefined

  for i in 0..10 {
    total += i as i64
    if i == 5 { continue }
    if i == 9 { break }
  }

  var tries = 0
  let answer = loop {
    tries += 1
    if tries == 3 { break tries * 14 }
  }

  outer: loop {
    loop { break :outer }
  }

  let size = sizeof(point)
  let ok: bool = true
  let nope = false
  let nothing = null

  let count: u8 = 255u8
  let big: i64 = 9000000000i64
  let hex: i32 = 0xff
  let bin: i32 = 0b1010
  let oct: i32 = 0o17i32

  let million: int = 1_000_000
  let masked: i32 = 0xff_ff
  let ratio: float = 1_000.000_1
  let scale: f32 = 1.5f32
  let epsilon: f64 = 1e-9f64
  let unit: f32 = 1f32

  let name: cstr = "ramon"
  let greeting: str = "héllo"
  printf("hi %s, area %lld\n", name, area(rect { origin: ORIGIN, w: 2, h: 5 }))
  printf("a tab\tand quote \"\n")

  total *= 2
  total -= 1
  total /= 1
  return classify(total as i32) + width(greeting) as i32 + vector.first()
}
