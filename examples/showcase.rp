// Highlighting
import math.vector

struct point { x: i32, y: i32 }

struct rect { origin: point, w: i32, h: i32 }

enum color { red, green, blue }

const PI: f32 = 3.14159
var ORIGIN: point = point { x: 0, y: 0 }

extern func printf(fmt: cstr, ...) i32
extern func malloc(size: usize) *opaque

func width(s: str) usize {
  return s.len
}

func area(r: rect) i64 {
  return i64(r.w) * i64(r.h)
}

func code(c: color) i32 {
  return match c {
    color.red => 10,
    color.green => 20,
    _ => 30,
  }
}

func classify(n: i32) i32 {
  if n < 0 {
    return -1
  } else if n > 0 {
    return 1
  } else {
    return 0
  }
}

func bits(flags: u8, mask: u8) u8 {
  return flags & mask | ~mask ^ flags << 1 >> 2
}

pub func main() i32 {
  var total: i64 = 0
  var buf: [4]i32 = undefined

  for i in 0..10 {
    total += i64(i)
    if i == 5 { continue }
    if i == 9 { break }
  }

  var tries = 0
  var answer = loop {
    tries += 1
    if tries == 3 { break tries * 14 }
  }

  outer: loop {
    loop { break :outer }
  }

  var size = sizeof(point)
  var ok: bool = true
  var nope = false
  var nothing = null

  var count: u8 = 255u8
  var big: i64 = 9000000000i64
  var hex: i32 = 0xff
  var bin: i32 = 0b1010
  var oct: i32 = 0o17i32

  var million: int = 1_000_000
  var masked: i32 = 0xff_ff
  var ratio: float = 1_000.000_1
  var scale: f32 = 1.5f32
  var epsilon: f64 = 1e-9f64
  var unit: f32 = 1f32

  var name: cstr = "ramon"
  var greeting: str = "héllo"
  printf("hi %s, area %lld\n", name, area(rect { origin: ORIGIN, w: 2, h: 5 }))
  printf("a tab\tand quote \"\n")

  total *= 2
  total -= 1
  total /= 1
  return classify(i32(total)) + i32(width(greeting)) + vector.first()
}
