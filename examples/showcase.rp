// Highlighting
/* block /* nested */ comment */

point :: struct { x: i32, y: i32 };

rect :: struct { origin: point, w: i32, h: i32 };

color :: enum { red, green, blue };

shape :: enum { circle(i32), square(i32), empty };

byte :: u8;

origin : point = point.{ x = 0, y = 0 };
total := 0;

printf : (cstr, ..) -> i32 : extern "C";
malloc : (usize) -> ptr : extern "C";

width :: fn(s: str) -> usize => s.len;

area :: fn(r: rect) -> i64 {
  cast(i64, r.w) * cast(i64, r.h)
};

code :: fn(c: color) -> i32 {
  match c {
    color.red => 10,
    color.green => { 20 },
    _ => 30,
  }
};

side : (shape) -> i32 : fn match {
  .circle(r) => 2 * r,
  .square(s) => s,
  .empty => 0,
};

classify :: fn(n: i32) -> i32 {
  if n < 0 { -1 } else if n > 0 { 1 } else { 0 }
};

bits :: fn(flags: u8, mask: u8) -> u8 {
  flags & mask | ~mask ^ flags << 1 >> 2
};

main :: fn() -> i32 {
  sum : i64 = 0;
  buf : [4]i32 = [1, 2, 3, 4];

  for i := 0..10 {
    sum += cast(i64, i);
    if i == 5 { continue };
    if i == 9 { break }
  };

  tries := 0;
  answer := loop {
    tries += 1;
    if tries == 3 { break tries * 14 }
  };

  loop @outer {
    loop { break @outer }
  };

  size := sizeof(point);
  ok : bool = true;
  nope := false;
  nothing : ptr = null;
  letter : char = 'a';

  count : u8 = 255u8;
  big : i64 = 9000000000i64;
  hex : i32 = 0xff;
  bin : i32 = 0b1010;
  oct : i32 = 0o17i32;

  million : i32 = 1_000_000;
  masked : i32 = 0xff_ff;
  ratio : f64 = 1_000.000_1;
  scale : f32 = 1.5f32;
  epsilon : f64 = 1e-9f64;
  unit : f32 = 1f32;

  name : cstr = "ramon";
  greeting : str = "héllo";
  _ := printf("hi %s, area %lld\n", name, area(rect.{ origin = origin, w = 2, h = 5 }));
  _ := printf("a tab\tand quote \"\n");

  sum *= 2;
  sum -= 1;
  sum /= 1;
  classify(cast(i32, sum)) + cast(i32, width(greeting)) + code(color.blue) + side(.circle(buf[0]))
};
